{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DataMeshBeaconEvent",
  "type": "object",
  "description": "Whitelisted beacon event fields used for feature computation and metrics.",
  "properties": {
    "Id": { "type": "string" },
    "DeviceID": { "type": "string" },
    "BeaconEventID": { "type": "integer" },
    "MeanConductivity": { "type": "number" },
    "SetpointConductivity": { "type": "number" },
    "MeanWashTankTemp": { "type": "number" },
    "MeanRinseTemp": { "type": "number" },
    "EnFillOn": { "type": "integer" },
    "EnRinseOn": { "type": "integer" },
    "EnWashOn": { "type": "integer" },
    "VersionAndMessageType": { "type": "integer" },
    "DateTimeUTC": { "type": "integer" },
    "MACAddressString": { "type": "string" },
    "_architecture": { "type": "string", "enum": ["datamesh"] },
    "_data_product": { "type": "string", "enum": ["washing", "rinsing", "chemistry"] }
  },
  "required": [
    "Id",
    "DeviceID",
    "MACAddressString",
    "BeaconEventID",
    "MeanConductivity",
    "SetpointConductivity",
    "MeanWashTankTemp",
    "MeanRinseTemp",
    "EnFillOn",
    "EnRinseOn",
    "EnWashOn",
    "VersionAndMessageType",
    "DateTimeUTC"
  ]
}